# Server-only Appwrite key with rows.read access to the publishing catalog.
CATALOG_API_KEY=

# Keep false for every local, preview, and staging deployment. Set true only
# for the approved production deployment when fickledragon.com is ready to index.
SITE_INDEXING_ENABLED=false

# Existing Fickle Dragon GA4 web stream. Leave unset to disable analytics and
# its consent UI cleanly. Production uses G-SS2ZB4J95T.
GA4_MEASUREMENT_ID=
